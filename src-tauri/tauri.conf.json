{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF Pair",
  "version": "0.1.2",
  "identifier": "com.pdfpair.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PDF Pair",
        "width": 1440,
        "height": 900,
        "minWidth": 760,
        "minHeight": 620,
        "decorations": false,
        "transparent": true,
        "center": true,
        "shadow": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Offline dual-pane PDF comparison reader",
    "longDescription": "Read and compare two local PDF documents with synchronized scrolling and independent controls.",
    "copyright": "Copyright © 2026 PDF Pair contributors"
  }
}
